# Public hostname already pointing to the VPS. Caddy obtains and renews TLS.
TAIJU_DOMAIN=taiju.example.com
SUWAYOMI_PUBLIC_URL=https://taiju.example.com/suwayomi

# Use long, unique, alphanumeric values. Do not use spaces, quotes or $.
POSTGRES_USER=taiju
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Comma-separated accounts allowed to access sources marked MIXED or NSFW.
ADULT_CONTENT_EMAILS=

# Anime extensions run through the private Miwayomi sidecar. FlareSolverr is an
# internal-only sidecar used for sources that present a Cloudflare challenge.
# Configure extension repositories only through the SSH tunnel in DEPLOYMENT.md.
